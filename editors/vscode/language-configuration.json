{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^(load|df|merge|pivot|group\\s+by|plot|python|start|save)\\b.*$",
    "decreaseIndentPattern": "^(load|df|merge|pivot|group|python|plot|start|save)\\b"
  },
  "wordPattern": "[a-zA-Z][a-zA-Z0-9_]*|:[a-zA-Z][a-zA-Z0-9_]*|\\d+(\\.\\d+)?"
}
