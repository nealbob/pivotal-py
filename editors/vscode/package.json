{
  "name": "pivotal-language",
  "displayName": "Pivotal",
  "description": "Syntax highlighting and execution support for the Pivotal data transformation DSL",
  "version": "0.4.1",
  "publisher": "pivotal",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pivotal/pivotal-py"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:pivotal"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pivotal",
        "aliases": ["Pivotal", "pivotal"],
        "extensions": [".pivotal"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pivotal",
        "scopeName": "source.pivotal",
        "path": "./syntaxes/pivotal.tmLanguage.json"
      },
      {
        "scopeName": "source.pivotal.injection",
        "path": "./syntaxes/pivotal-injection.tmLanguage.json",
        "injectTo": ["source.python"]
      }
    ],
    "commands": [
      {
        "command": "pivotal.executeFile",
        "title": "Pivotal: Execute File",
        "icon": "$(play)"
      },
      {
        "command": "pivotal.executeInNotebook",
        "title": "Pivotal: Execute in Interactive Notebook",
        "icon": "$(notebook)"
      },
      {
        "command": "pivotal.executeSelectionInNotebook",
        "title": "Pivotal: Execute Selection in Interactive Notebook",
        "icon": "$(run-above)"
      },
      {
        "command": "pivotal.compileToFile",
        "title": "Pivotal: Compile to Python File",
        "icon": "$(export)"
      },
      {
        "command": "pivotal.showViewer",
        "title": "Pivotal: Show Viewer",
        "icon": "$(preview)"
      }
    ],
    "keybindings": [
      {
        "command": "pivotal.executeFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == pivotal"
      },
      {
        "command": "pivotal.executeSelectionInNotebook",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5",
        "when": "editorLangId == pivotal && editorHasSelection"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "pivotal.executeFile",
          "when": "resourceLangId == pivotal",
          "group": "navigation@1"
        },
        {
          "command": "pivotal.executeInNotebook",
          "when": "resourceLangId == pivotal",
          "group": "navigation@2"
        },
        {
          "command": "pivotal.compileToFile",
          "when": "resourceLangId == pivotal",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "pivotal.executeSelectionInNotebook",
          "when": "editorHasSelection",
          "group": "pivotal@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
