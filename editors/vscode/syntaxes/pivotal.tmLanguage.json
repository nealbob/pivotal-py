{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pivotal",
  "scopeName": "source.pivotal",
  "fileTypes": [
    "pivotal"
  ],
  "patterns": [
    {
      "include": "#block-comments"
    },
    {
      "include": "#python-embedded"
    },
    {
      "include": "#line-comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#python-vars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords-primary"
    },
    {
      "include": "#keywords-clause"
    },
    {
      "include": "#keywords-merge-type"
    },
    {
      "include": "#keywords-comparator"
    },
    {
      "include": "#keywords-logical"
    },
    {
      "include": "#sort-modifiers"
    },
    {
      "include": "#agg-functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "python-embedded": {
      "patterns": [
        {
          "comment": "Multi-line Python block: python ... end",
          "name": "meta.embedded.block.python.pivotal",
          "begin": "^(\\s*)(python)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.pivotal"
            }
          },
          "end": "^(\\1)(end)\\s*$",
          "endCaptures": {
            "2": {
              "name": "keyword.control.pivotal"
            }
          },
          "contentName": "source.python.embedded.pivotal",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "comment": "Single-line Python statement: python <code>",
          "name": "meta.embedded.line.python.pivotal",
          "begin": "^(\\s*)(python)\\b(?=\\s+\\S)",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.pivotal"
            }
          },
          "end": "$",
          "contentName": "source.python.embedded.pivotal",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        }
      ]
    },
    "block-comments": {
      "name": "comment.block.pivotal",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "line-comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pivotal",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-dash.pivotal",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pivotal",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pivotal",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.pivotal",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pivotal",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "python-vars": {
      "name": "variable.other.pivotal",
      "match": ":[a-zA-Z][a-zA-Z0-9_]*"
    },
    "numbers": {
      "name": "constant.numeric.pivotal",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.pivotal",
          "match": "(?i)\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.pivotal",
          "match": "(?i)\\bnone\\b"
        }
      ]
    },
    "keywords-primary": {
      "comment": "Statement-opening commands",
      "name": "keyword.control.pivotal",
      "match": "\\b(load|bulk|with|from|for|function|return|list|scalar|dict|filter|assert|check|select|sort|order|group|merge|pivot|python|plot|drop|fillna|dropna|distinct|concat|intersect|exclude|rename|round|apply|save|end|delete|show|unpivot|rolling|rank|lag|lead|cumsum|cummean|cummin|cummax|cast|agg|table|all)\\b"
    },
    "keywords-clause": {
      "comment": "Sub-clause and structural keywords",
      "name": "keyword.other.pivotal",
      "match": "\\b(query|where|else|as|on|by|rows|cols|agg|head|summary|shape|columns|strict|stub|format|id|order|variable|value|left_on|right_on|suffixes|header|names|path|include|exclude|chart_format|title|subtitle|font|size|spanner|auto|label|stripe|canvas|style|kind|colormap|legend|x|y|c|source|column|min_periods)\\b"
    },
    "keywords-merge-type": {
      "comment": "Merge type modifiers",
      "name": "storage.type.pivotal",
      "match": "\\b(left|right|inner|outer)\\b"
    },
    "keywords-comparator": {
      "comment": "Filter comparison operators — multi-word variants must come first",
      "patterns": [
        {
          "name": "keyword.operator.word.pivotal",
          "match": "\\bnot\\s+(in|contains|matches|startswith|endswith)\\b"
        },
        {
          "name": "keyword.operator.word.pivotal",
          "match": "\\b(not|in|unique|null|between|contains|matches|startswith|endswith)\\b"
        }
      ]
    },
    "keywords-logical": {
      "comment": "Boolean logic — case-insensitive per grammar",
      "name": "keyword.operator.logical.pivotal",
      "match": "(?i)\\b(and|or)\\b"
    },
    "sort-modifiers": {
      "name": "storage.modifier.pivotal",
      "match": "\\b(asc|desc|pct)\\b"
    },
    "agg-functions": {
      "comment": "Aggregation and built-in expression functions",
      "name": "support.function.pivotal",
      "match": "\\b(mean|min|max|sum|count|avg|median|std|nunique|quantile|percentile|wavg|wmean|upper|lower|trim|ltrim|rtrim|left|right|substr|len|replace|regex_extract|regex_replace|year|month|day|quarter|dayofweek|hour|minute|date_format|to_date|date_diff|date_add|int|integer|float|string|str|bool|boolean|datetime)\\b"
    },
    "operators": {
      "comment": "Symbolic comparison and arithmetic operators",
      "name": "keyword.operator.pivotal",
      "match": "(==|!=|>=|<=|>|<|\\*\\*|[+\\-*/=])"
    }
  }
}
