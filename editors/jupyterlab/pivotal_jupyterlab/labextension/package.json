{
  "name": "@pivotal/jupyterlab",
  "version": "0.1.0",
  "description": "JupyterLab syntax highlighting for the Pivotal data transformation DSL",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "pivotal"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "style/icons/pivotal_logo.svg",
  "style": "style/base.css",
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "style/**/*.{css,svg}",
    "schema/**/*.json",
    "pivotal_jupyterlab/labextension/**",
    "install.json"
  ],
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension",
    "build:prod": "jlpm run build:lib:prod && jlpm run build:labextension",
    "build:labextension": "jupyter labextension build . && jlpm copy:assets",
    "build:labextension:dev": "jupyter labextension build --development True . && jlpm copy:assets",
    "copy:assets": "mkdir -p pivotal_jupyterlab/labextension/style/icons && cp style/icons/pivotal_logo.svg pivotal_jupyterlab/labextension/style/icons/",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "jlpm run clean:lib && jlpm run clean:labextension",
    "clean:lib": "rimraf lib",
    "clean:labextension": "rimraf pivotal_jupyterlab/labextension",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w --sourceMap",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/codemirror": "^4.0.0",
    "@jupyterlab/docmanager": "^4.0.0",
    "@jupyterlab/filebrowser": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@jupyterlab/statusbar": "^4.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lumino/messaging": "^2.0.0",
    "@lumino/widgets": "^2.0.0",
    "ag-grid-community": "^33.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.0",
    "typescript": "~5.0.4"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "pivotal_jupyterlab/labextension",
    "schemaDir": "schema",
    "_build": {
      "load": "static\\remoteEntry.a9b8060e6f9399eca511.js",
      "extension": "./extension",
      "style": "./style"
    }
  }
}
