FROM python:3.12-slim

WORKDIR /app

COPY . .

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir ".[mcp]"

ENV PORT=8000
EXPOSE 8000

CMD ["python", "-m", "pivotal.mcp_server", "--read-only", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8000"]
