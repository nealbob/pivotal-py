-- Companion to package_demo.pivotal
-- Demonstrates loading a previously saved package without re-running the pipeline.
-- Run package_demo.pivotal first, then run this file.

python
    import os
    from pivotal import Package
    _ppath = os.environ.get('PIVOTAL_PATH', '.')
    _pivotal_pkg = Package.open("sales_demo", path=_ppath + '/output')

-- Restore all saved tables in one line
load all

-- Continue analysis on the summary table
df top from summary
filter total_revenue > 1000
sort total_revenue desc
