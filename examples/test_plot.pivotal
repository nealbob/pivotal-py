python
    import os
    _ppath = os.environ.get('PIVOTAL_PATH', '.')
    data_path = _ppath + '/examples/data/data.csv'
end

load temp :data_path

df df_plot from temp
    plot line price_chart
        x product
        y price
        title "Product Prices"
        legend False

df df_bar from temp
    plot bar category_chart
        x category
        y quantity
        title "Category Quantities"

df df_scatter from temp
    plot scatter scatter_chart
        x price
        y quantity
        c category
        colormap "viridis"

df df_facet from temp
    plot bar facet_chart
        x product
        y price
        by category
        cols 2

df df_styled from temp
    plot line styled_chart
        x product
        y price
        style ggplot
